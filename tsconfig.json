{
  "compilerOptions": {
    "target": "ES2020", "module": "none", "lib": ["ES2020", "DOM"],
    "rootDir": "src/main/ts", "outDir": "src/main/resources/static/js",
    "strict": true, "noEmitOnError": true
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src/main/ts",
    "outDir": "src/main/resources/static/js"
  },
  "include": ["src/main/ts/**/*.ts"]
}
